# 화면을 올릴 경로. 학교 서버의 /founder/ 아래에 올린다.
VITE_BASE_PATH=/founder/

# API 주소. 비우면 화면과 같은 경로(VITE_BASE_PATH)를 쓴다.
# 다른 서버의 API 를 볼 때만 전체 주소를 넣는다. 예) http://localhost:8000/
# VITE_API_BASE_URL=

# 개발 서버(npm run dev)가 API 요청을 넘겨줄 서버.
VITE_DEV_API_TARGET=https://campuslife.dongyang.ac.kr

# 백엔드를 직접 띄워(예: http://localhost:8000) 붙을 때만 true 로 둔다.
# 그 서버에는 /founder 경로가 없으므로 떼고 넘겨야 한다.
# 운영 서버로 넘길 때는 nginx 가 이미 떼므로 false 로 둔다.
VITE_DEV_API_STRIP_BASE=false
