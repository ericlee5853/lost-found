# 화면을 올릴 경로. 서버의 https://campuslife.dongyang.ac.kr/founder/ 아래에 올린다.
# 다른 경로에 올릴 때만 바꾼다.
VITE_BASE_PATH=/founder/

# API 주소. 비워 두면 화면과 같은 서버의 같은 경로(VITE_BASE_PATH)를 쓴다.
# 다른 서버의 API 를 보려면 전체 주소를 넣는다. 예) http://localhost:8000/
# VITE_API_BASE_URL=

# 개발 서버(npm run dev)에서 API 요청을 넘겨줄 서버.
VITE_DEV_API_TARGET=https://campuslife.dongyang.ac.kr
